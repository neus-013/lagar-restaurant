---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Galeria" headerVariant="overlay" active="galeria">
  <section class="gallery">
    <div class="gallery__grid">
      <img
        src={import.meta.env.BASE_URL + 'images/gourmet-paella-with-seafood-saffron-spice-generated-by-ai.jpg'}
        alt="Paella de marisc"
        class="gallery__item gallery__item--paella"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/high-angle-business-partners-working.jpg'}
        alt="Equip de Lagar Restaurant"
        class="gallery__item gallery__item--team"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/delicious-eggplant-dish-arrangement.jpg'}
        alt="Albergínies a la brasa"
        class="gallery__item"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/plato-espanol-anchoas-aceitunas_461960-3805.jpg'}
        alt="Anxoves amb olives"
        class="gallery__item"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/delicious-fried-croquette-arrangement.jpg'}
        alt="Croquetes casolanes"
        class="gallery__item gallery__item--croquetas"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/portion-beefsteak-dining-meal-barbecued.jpg'}
        alt="Entrecot a la planxa amb amanida"
        class="gallery__item"
      />
      <img
        src={import.meta.env.BASE_URL + 'images/delicious-volcano-chocolate-cake.jpg'}
        alt="Coulant de xocolata"
        class="gallery__item"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .gallery {
    position: relative;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-auto-rows: 400px;
  }

  .gallery__item {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__item--paella {
    grid-column: 1 / 3;
  }

  .gallery__item--team {
    grid-column: 3 / 5;
    grid-row: 1 / 3;
  }

  .gallery__item--croquetas {
    grid-column: 1 / 3;
  }

  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 260px;
    }

    .gallery__item--paella,
    .gallery__item--croquetas {
      grid-column: 1 / 3;
    }

    .gallery__item--team {
      grid-column: 1 / 3;
      grid-row: auto;
    }
  }

  @media (max-width: 480px) {
    .gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }

    .gallery__item--paella,
    .gallery__item--croquetas,
    .gallery__item--team {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
