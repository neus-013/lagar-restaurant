---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Carta" headerVariant="light" active="carta">
  <section class="carta-placeholder container">
    <h1>Carta</h1>
    <p>
      La nostra carta estarà disponible properament en format PDF descàrregable.
      Hi estem treballant — aviat podràs consultar-la des d'aquí.
    </p>
  </section>
</BaseLayout>

<style>
  .carta-placeholder {
    padding: 6rem 0;
    text-align: center;
  }

  .carta-placeholder h1 {
    font-size: var(--fs-h2);
    margin-bottom: 1.5rem;
  }
</style>
