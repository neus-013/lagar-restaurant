---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reserva" headerVariant="light" active="reserva">
  <section class="reserva">
    <div class="container reserva__inner">
      <h1 class="reserva__title">Reserva tu mesa</h1>

      <p class="reserva__text">
        Por el momento solo gestionamos las reservas <strong>vía telefónica</strong>.
      </p>
      <p class="reserva__text">
        Llámanos y estaremos encantados de reservar tu mesa!
      </p>

      <a href="tel:933468270" class="reserva__button">
        <img src={import.meta.env.BASE_URL + 'icons/llamada-telefonica.svg'} alt="" class="reserva__button-icon" />
        933 46 82 70
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .reserva {
    padding: 5rem 0 8rem;
    text-align: center;
  }

  .reserva__inner {
    max-width: 640px;
  }

  .reserva__title {
    font-size: var(--fs-h2);
    margin-bottom: 2.5rem;
  }

  .reserva__text {
    font-size: var(--fs-body);
    margin-bottom: 0.5rem;
  }

  .reserva__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    background-color: var(--color-accent);
    color: var(--color-text-inverse);
    font-size: 1.2rem;
    font-weight: 600;
    padding: 1.1rem 2.5rem;
    border-radius: var(--radius);
  }

  .reserva__button-icon {
    width: 22px;
    height: 22px;
    filter: brightness(0) invert(1);
  }
</style>
