---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  headerVariant?: 'overlay' | 'dark' | 'light';
  active?: 'carta' | 'galeria' | 'sobre-nosotros' | 'reserva' | null;
}

const {
  title,
  description = 'Lagar Restaurant — Cocina creativa mediterránea en el corazón de Sant Andreu.',
  headerVariant = 'light',
  active = null,
} = Astro.props;

const pathname = Astro.url.pathname;
const lang = pathname.startsWith('/cat') ? 'cat' : 'es';

// Pàgines amb slug diferent en cada idioma
const slugMap: Record<string, string> = {
  '/sobre-nosotros':       '/cat/sobre-nosaltres',
  '/cat/sobre-nosaltres':  '/sobre-nosotros',
};

const altHref = slugMap[pathname] ?? (
  lang === 'cat'
    ? (pathname.replace(/^\/cat/, '') || '/')
    : `/cat${pathname === '/' ? '/' : pathname}`
);
---

<!doctype html>
<html lang={lang === 'cat' ? 'ca' : 'es'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Lagar Restaurant</title>
  </head>
  <body>
    <Header variant={headerVariant} active={active} lang={lang} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
