---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  headerVariant?: 'overlay' | 'dark' | 'light';
  active?: 'carta' | 'galeria' | 'sobre-nosotros' | 'reserva' | null;
}

const {
  title,
  description = 'Lagar Restaurant — Cocina creativa mediterránea en el corazón de Sant Andreu.',
  headerVariant = 'light',
  active = null,
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. '/lagar-restaurant' or ''
const pathname = Astro.url.pathname;
// Strip the base prefix so language detection works regardless of deployment path
const pagePath = BASE && pathname.startsWith(BASE)
  ? pathname.slice(BASE.length) || '/'
  : pathname;
const lang = pagePath.startsWith('/cat') ? 'cat' : 'es';

// Pàgines amb slug diferent en cada idioma
const slugMap: Record<string, string> = {
  '/sobre-nosotros':       '/cat/sobre-nosaltres',
  '/cat/sobre-nosaltres':  '/sobre-nosotros',
};

const relPath = slugMap[pagePath] ?? (
  lang === 'cat'
    ? (pagePath.replace(/^\/cat/, '') || '/')
    : `/cat${pagePath === '/' ? '/' : pagePath}`
);

const altHref = `${BASE}${relPath}`;
---

<!doctype html>
<html lang={lang === 'cat' ? 'ca' : 'es'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Lagar Restaurant</title>
  </head>
  <body>
    <Header variant={headerVariant} active={active} lang={lang} altHref={altHref} />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
