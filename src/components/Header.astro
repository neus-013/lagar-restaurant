---
// Cabecera común a todas las páginas.
// `variant` controla el color según el fondo de cada página:
//   "overlay" -> transparente, texto blanco, posicionada sobre una imagen (Home, Galería)
//   "dark"    -> fondo marrón sólido, texto blanco (Sobre Nosotros)
//   "light"   -> fondo crema sólido, texto oscuro (Reserva)
// `active` indica qué item de menú resaltar en ocre.

interface Props {
  variant?: 'overlay' | 'dark' | 'light';
  active?: 'carta' | 'galeria' | 'sobre-nosotros' | 'reserva' | null;
  lang?: 'es' | 'cat';
  altHref?: string;
}

const { variant = 'light', active = null, lang = 'es', altHref = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = lang === 'cat' ? [
  { key: 'carta',          label: 'Carta',           href: `${base}/cat/carta` },
  { key: 'galeria',        label: 'Galeria',          href: `${base}/cat/galeria` },
  { key: 'sobre-nosotros', label: 'Sobre Nosaltres',  href: `${base}/cat/sobre-nosaltres` },
  { key: 'reserva',        label: 'Reserva',          href: `${base}/cat/reserva` },
] : [
  { key: 'carta',          label: 'Carta',            href: `${base}/carta` },
  { key: 'galeria',        label: 'Galería',          href: `${base}/galeria` },
  { key: 'sobre-nosotros', label: 'Sobre Nosotros',   href: `${base}/sobre-nosotros` },
  { key: 'reserva',        label: 'Reserva',          href: `${base}/reserva` },
];
---

<header class={`site-header site-header--${variant}`}>
  <div class="site-header__inner">
    <a href={`${base}/`} class="site-header__logo">
      <img src={import.meta.env.BASE_URL + 'images/lagar-logo-ocre.png'} alt="Lagar Restaurant" class="site-header__logo-img" />
    </a>

    <nav class="site-header__nav">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`site-header__nav-link ${active === item.key ? 'is-active' : ''}`}
        >
          {item.label.toUpperCase()}
        </a>
      ))}
    </nav>

    <div class="site-header__lang-picker">
      {lang === 'es' ? (
        <>
          <span class="site-header__lang-option is-current">ES</span>
          <span class="site-header__lang-sep">|</span>
          <a href={altHref} class="site-header__lang-option">CAT</a>
        </>
      ) : (
        <>
          <a href={altHref} class="site-header__lang-option">ES</a>
          <span class="site-header__lang-sep">|</span>
          <span class="site-header__lang-option is-current">CAT</span>
        </>
      )}
    </div>

    <button class="site-header__burger" aria-label="Menú" aria-expanded="false">
      <span class="site-header__burger-bar"></span>
      <span class="site-header__burger-bar"></span>
      <span class="site-header__burger-bar"></span>
    </button>
  </div>
</header>

<script>
  const burger = document.querySelector('.site-header__burger') as HTMLButtonElement | null;
  const nav = document.querySelector('.site-header__nav');
  const header = document.querySelector('.site-header');

  burger?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    burger.classList.toggle('is-open');
    header?.classList.toggle('menu-is-open');
    burger.setAttribute('aria-expanded', String(isOpen));
  });
</script>

<style>
  .site-header {
    width: 100%;
    z-index: 10;
    padding: 1.5rem 0;
  }

  .site-header--overlay {
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;
    color: var(--color-text-inverse);
  }

  .site-header--dark {
    position: relative;
    background-color: var(--color-tierra);
    color: var(--color-text-inverse);
  }

  .site-header--light {
    position: relative;
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 1.5rem;
  }

  .site-header__logo {
    flex-shrink: 0;
    line-height: 0;
  }

  .site-header__logo-img {
    height: 44px;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .site-header__nav-link {
    font-size: var(--fs-nav);
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }

  .site-header__nav-link:hover {
    color: var(--color-accent);
  }

  .site-header__nav-link.is-active {
    color: var(--color-tierra);
  }

  .site-header__lang-picker {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .site-header__lang-option {
    text-decoration: none;
    color: inherit;
  }

  .site-header__lang-option.is-current {
    color: var(--color-accent) !important;
    cursor: default;
    pointer-events: none;
  }

  .site-header__lang-option:not(.is-current):hover {
    color: var(--color-accent);
  }

  .site-header__lang-sep {
    opacity: 0.35;
  }

  /* === Burger === */
  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: inherit;
  }

  .site-header__burger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* === Mobile === */
  @media (max-width: 768px) {
    .site-header {
      padding: 1rem 0;
    }

    .site-header__inner {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0;
    }

    .site-header__logo {
      flex: 0 0 auto;
      order: 1;
      margin-right: auto;
    }

    .site-header__lang-picker {
      order: 2;
      flex-shrink: 0;
      align-self: center;
    }

    .site-header__burger {
      display: flex;
      order: 3;
      flex-shrink: 0;
      align-self: center;
      margin-left: 0.75rem;
    }

    .site-header__nav {
      display: none;
      order: 4;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding-top: 0.25rem;
      padding-bottom: 0.75rem;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__nav-link {
      padding: 0.75rem 0;
      font-size: 0.875rem;
      border-bottom: 1px solid rgba(128, 128, 128, 0.2);
    }

    .site-header__nav-link:last-child {
      border-bottom: none;
    }

    .site-header--overlay.menu-is-open {
      background-color: rgba(43, 38, 32, 0.97);
    }

    .site-header__burger.is-open .site-header__burger-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .site-header__burger.is-open .site-header__burger-bar:nth-child(2) {
      opacity: 0;
    }

    .site-header__burger.is-open .site-header__burger-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
